# Copy this file to .env.local (same folder as package.json) and fill it in.
# Never commit .env.local. It is already ignored by .gitignore.
# Contact form (Resend, https://resend.com). Until these three are set,
# the form politely tells visitors to email you instead.

RESEND_API_KEY=
CONTACT_TO_EMAIL=you@yourdomain.com
CONTACT_FROM_EMAIL="AegisBrain <onboarding@resend.dev>"
dotenv     NEXT_PUBLIC_API_URL=http://127.0.0.1:8000